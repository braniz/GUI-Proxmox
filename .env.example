# Flask session secret (zufälliger langer String): python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me
# Login-Benutzer und Passwort-HASH (kein Klartext!): python generate_hash.py
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
# Proxmox (read-only API-Token, Rolle PVEAuditor)
PVE_HOST=pve.example.local
PVE_PORT=8006
PVE_TOKEN_ID=monitor-user@pve!monitoring-token
PVE_TOKEN_SECRET=
# TLS-Zertifikat prüfen (true/false) oder Pfad zu CA-Datei
PVE_VERIFY_SSL=true
# Auf true setzen, wenn die App über HTTPS ausgeliefert wird
SESSION_COOKIE_SECURE=false
# Dienst-Erkennung per TCP-Connect (Port:Label, kommagetrennt) und Schalter
SERVICE_CHECK=true
SERVICE_PORTS=22:ssh,80:http,443:https
# Auto-ToDo-Erstellung im Kanban aktivieren, wenn erforderliche Dienste fehlen/gestoppt sind
AUTO_TODO_ENABLED=true
# Erforderliche Dienste pro VMID: "vmid:dienst1,dienst2;vmid2:dienst3"; * gilt für alle VMs
# Beispiel: *:ssh;100:http,https
REQUIRED_SERVICES=*:ssh
# Optionaler Hintergrund-Check in Sekunden (0 = aus, Empfehlung: 60)
SERVICE_MONITOR_INTERVAL=0
# Speicherort der manuellen Kommentare (Standard: data/comments.json)
#COMMENTS_DB=data/comments.json
# Speicherort der Kanban-ToDos (Standard: data/kanban-todos.json)
#KANBAN_TODOS_DB=data/kanban-todos.json
# Pfad zur Host-Info-Datei für das Kanbanboard
#HOST_INFO_FILE=/srv/info/host.info
#DATA_DIR=data
